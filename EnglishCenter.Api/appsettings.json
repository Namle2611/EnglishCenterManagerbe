{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "EnglishCenter.Api",
    "Audience": "EnglishCenter.Web",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5137",
      "http://localhost:5173"
    ]
  },
  "ForwardedHeaders": {
    "KnownProxies": [
      "127.0.0.1",
      "::1"
    ],
    "KnownNetworks": []
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Refresh": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "ChangePassword": {
      "PermitLimit": 5,
      "WindowSeconds": 300
    }
  },
  "AdminSeed": {
    "Email": "admincenter@gmail.com",
    "FullName": "System Administrator"
  },
  "Gemini": {
    "Model": "gemini-3.8-flash",
    "TimeoutSeconds": 30,
    "MaxOutputTokens": 8192
  }
}
