  },
  "Otp": {
    "HashKey": ""
  },
  "AdminSeed": {
    "Email": "admincenter@gmail.com",
    "FullName": "System Administrator"
  },
  "Gemini": {
    "Model": "gemini-3.8-flash",
    "TimeoutSeconds": 30,
